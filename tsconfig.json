{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "outDir": "dist",
        "rootDir": ".",
        "allowJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["./**/*.ts", "./**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
