{
  "name": "nodejs-homeworks",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --inspect index.ts",
    "build": "tsc && npm run lint && npm run prettier:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prettier:check": "prettier --check '**/*.{ts}'",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "prettier:fix": "prettier --write '**/*.{ts}'",
    "backup": "tsx scripts/usersBackup.ts"
  },
  "lint-staged": {
    "*.{ts}": "eslint --fix"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^5.0.0",
    "ms": "^2.1.3",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
