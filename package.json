{
  "name": "nodejs-homeworks",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --inspect index.js",
    "build": "npm run lint && npm run prettier:check",
    "lint": "eslint .",
    "prettier:check": "prettier --check '**/*.{js,mjs,cjs}'",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "prettier:fix": "prettier --write '**/*.{js,mjs,cjs}'",
    "backup": "node scripts/usersBackup.js"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^5.0.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
